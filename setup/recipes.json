[
  {
    "id": "workspace-dependencies",
    "effect": "prepare",
    "host": "studio",
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "action": "dependencies",
    "licenseIds": [],
    "commands": [
      {
        "executable": "$npm",
        "args": [
          "ci",
          "--prefix",
          "{destination}",
          "--no-audit",
          "--no-fund"
        ]
      }
    ],
    "source": "package-lock.json",
    "available": true,
    "options": [
      {
        "key": "destination",
        "type": "path",
        "required": true
      }
    ]
  },
  {
    "id": "codex-cli",
    "effect": "prepare",
    "host": "studio",
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "licenseIds": [],
    "commands": [
      {
        "executable": "$npm",
        "args": [
          "install",
          "--prefix",
          "{destination}",
          "--no-audit",
          "--no-fund",
          "@openai/codex@{version}"
        ]
      }
    ],
    "source": "https://learn.chatgpt.com/docs/enterprise/windows-deployment",
    "available": true,
    "options": [
      {
        "key": "destination",
        "type": "path",
        "required": true
      },
      {
        "key": "version",
        "type": "version",
        "required": true
      }
    ]
  },
  {
    "id": "isaac6-runtime",
    "effect": "prepare",
    "host": "compute",
    "platforms": [
      "linux"
    ],
    "licenseIds": [
      "omniverse-eula:6.0.0.1"
    ],
    "commands": [
      {
        "executable": "{python}",
        "args": [
          "-m",
          "venv",
          "{destination}"
        ]
      },
      {
        "executable": "{newPython}",
        "args": [
          "-m",
          "pip",
          "install",
          "torch==2.11.0",
          "--index-url",
          "https://download.pytorch.org/whl/cu128"
        ]
      },
      {
        "executable": "{newPython}",
        "args": [
          "-m",
          "pip",
          "install",
          "isaacsim[all,extscache]==6.0.0.1",
          "numpy==2.3.1",
          "trimesh==4.11.1",
          "yourdfpy==0.0.60",
          "imageio",
          "imageio-ffmpeg",
          "Pillow",
          "--extra-index-url",
          "https://pypi.nvidia.com"
        ]
      }
    ],
    "source": "https://docs.isaacsim.omniverse.nvidia.com/6.0.0/installation/install_python.html",
    "version": "6.0.0.1",
    "licenseUrl": "https://docs.omniverse.nvidia.com/platform/latest/common/NVIDIA_Omniverse_License_Agreement.html",
    "available": true,
    "options": [
      {
        "key": "destination",
        "type": "path",
        "required": true
      },
      {
        "key": "basePython",
        "type": "path",
        "required": false
      }
    ],
    "diskBytes": 53687091200
  },
